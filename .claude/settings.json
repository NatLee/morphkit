{
  "permissions": {
    "allow": [
      "Bash(npx tsc:*)",
      "Bash(npm run build:*)",
      "Bash(npm run check:context:*)",
      "Bash(npx vite build:*)",
      "Bash(node .claude/scripts/check-context.mjs:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(wc:*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/scripts/check-context.mjs --hook",
            "timeout": 30,
            "statusMessage": "Checking context maps"
          }
        ]
      }
    ]
  }
}
